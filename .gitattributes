# ==============================================================================
# LAGRANGIAN PARTICLE TRACKING PROJECT - .gitattributes
# ==============================================================================
# This file defines attributes for path patterns in Git.
# It controls line endings, diff behavior, and marks binary files.
# ==============================================================================

# ==============================================================================
# LINE ENDINGS - Ensure consistent line endings across platforms
# ==============================================================================
# Set default behavior to automatically normalize line endings
* text=auto

# Python source files - enforce LF line endings
*.py text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# Shell scripts - enforce LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Batch scripts - enforce CRLF line endings (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Configuration files - enforce LF line endings
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Documentation - enforce LF line endings
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
README text eol=lf

# ==============================================================================
# BINARY FILES - Mark as binary to prevent line ending conversion
# ==============================================================================
# Model files and checkpoints (binary format)
*.pth binary
*.pt binary
*.ckpt binary
*.safetensors binary
*.pkl binary
*.pickle binary

# Data files (binary formats)
*.npy binary
*.npz binary
*.h5 binary
*.hdf5 binary
*.flo binary

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.svg binary
*.webp binary

# Videos (binary)
*.mp4 binary
*.avi binary
*.mov binary
*.mkv binary
*.flv binary
*.wmv binary
*.webm binary

# Archives (binary)
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary

# Compiled Python (binary)
*.pyc binary
*.pyo binary
*.pyd binary
*.so binary
*.dll binary
*.dylib binary

# ==============================================================================
# DIFF BEHAVIOR - Custom diff drivers for specific file types
# ==============================================================================
# Treat Jupyter notebooks with special diff handling
*.ipynb diff=jupyternotebook

# CSV files - use text diff with word-diff
*.csv diff=csv

# ==============================================================================
# MERGE BEHAVIOR - Define merge strategies
# ==============================================================================
# Jupyter notebooks - use custom merge driver if available
# (Requires nbdime or similar tool to be installed)
# *.ipynb merge=jupyternotebook

# ==============================================================================
# GIT LFS - Large File Storage tracking (if using Git LFS)
# ==============================================================================
# Uncomment and customize if using Git LFS for large files

# Model checkpoints (typically large, > 100MB)
# *.pth filter=lfs diff=lfs merge=lfs -text
# *.pt filter=lfs diff=lfs merge=lfs -text
# *.ckpt filter=lfs diff=lfs merge=lfs -text

# Large data files
# *.h5 filter=lfs diff=lfs merge=lfs -text
# *.hdf5 filter=lfs diff=lfs merge=lfs -text
# *.npy filter=lfs diff=lfs merge=lfs -text
# *.npz filter=lfs diff=lfs merge=lfs -text

# Video files (usually large)
# *.mp4 filter=lfs diff=lfs merge=lfs -text
# *.avi filter=lfs diff=lfs merge=lfs -text
# *.mov filter=lfs diff=lfs merge=lfs -text

# ==============================================================================
# EXPORT IGNORE - Files to exclude from git archive
# ==============================================================================
# These files won't be included when creating a git archive/export
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
docs/ export-ignore
